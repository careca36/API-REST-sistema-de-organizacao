generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  pendente
  em_andamento
  concluida
}

model Materia {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String
  tarefas   Tarefa[]
}

model Tarefa {
  id          Int      @id @default(autoincrement())
  titulo      String
  status      Status   @default(pendente)
  dataEntrega DateTime
  materiaId   Int

  materia     Materia  @relation(fields: [materiaId], references: [id])

}
