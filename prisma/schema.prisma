generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Materia {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  tarefas   Tarefa[]
}

model Tarefa {
  id          Int      @id @default(autoincrement())
  titulo      String
  descricao   String?
  status      Boolean  @default(false)
  dataEntrega DateTime
  materiaId   Int
  materia     Materia  @relation(fields: [materiaId], references: [id])
}
